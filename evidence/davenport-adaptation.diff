-  have hfilter :
-      (Finset.range (N + 1)).filter (fun n => n ∈ primitiveKernel A) = primitiveTrunc A N := by
-    ext n
-    constructor
-    · intro hn
-      rcases Finset.mem_filter.mp hn with ⟨hrange, hprim⟩
-      have hn1 : 1 ≤ n := Nat.succ_le_of_lt hprim.2.1
